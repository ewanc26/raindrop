UNIFIED_SOURCES += [
    "AtProtocolHandler.cpp",
    "AtRecordResolver.cpp",
]

# These parsers define same-named anonymous-namespace helpers (IsDigit, Split,
# ...) that collide if unified into one translation unit.
SOURCES += [
    "AtURI.cpp",
    "CidVerifier.cpp",
    "DidResolver.cpp",
    "ErrorView.cpp",
    "HandleResolver.cpp",
    "PdsClient.cpp",
    "RecordView.cpp",
]

LOCAL_INCLUDES += [
    "/netwerk/base",
    "/toolkit/components/jsoncpp/include",
]

XPCOM_MANIFESTS += ["components.conf"]

XPCSHELL_TESTS_MANIFESTS += ["tests/xpcshell.toml"]

TEST_DIRS += ["tests"]

FINAL_LIBRARY = "xul"
