{
  "manifest_version": 2,

  "browser_specific_settings": {
    "gecko": {
      "id": "raindrop@ewancroft.uk"
    }
  },

  "name": "raindrop",
  "description": "raindrop's night-sky theme with a cool drop accent.",
  "author": "raindrop",
  "version": "1.0.0",

  "icons": { "32": "icon.svg" },

  "theme": {
    "colors": {
      "frame": "#eef7fb",
