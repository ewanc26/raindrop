      "popup_highlight_text": "#12294a",
      "sidebar": "#f4fafc",
      "sidebar_text": "#12294a",
      "sidebar_border": "#cfe4ee",
      "sidebar_highlight": "#0f766e",
      "sidebar_highlight_text": "#ffffff",
      "ntp_background": "#eef7fb",
      "ntp_text": "#12294a",
      "ntp_card_background": "#ffffff"
    }
  },

  "dark_theme": {
    "colors": {
      "frame": "#0b1b33",
      "frame_inactive": "#081426",
      "toolbar": "#12294a",
      "toolbar_text": "#e6f6ff",
      "toolbar_field": "#0c2038",
