      "toolbar_field_text_focus": "#12294a",
      "toolbar_field_border": "#7aa7bd",
      "toolbar_field_border_focus": "#0d9488",
      "toolbar_field_highlight": "rgba(13, 148, 136, 0.22)",
      "toolbar_field_highlight_text": "#12294a",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "#cfe4ee",
      "toolbar_vertical_separator": "#cfe4ee",
      "tab_text": "#12294a",
      "tab_background_text": "#12294a",
      "tab_background_separator": "#b6d4e3",
